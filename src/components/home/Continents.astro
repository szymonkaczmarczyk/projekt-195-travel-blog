---
import { Image } from 'astro:assets';
import { continentStats, photosFor, type Visit } from '../../lib/data';

interface Props {
  visits: Visit[];
}

const { visits } = Astro.props;
const items = continentStats(visits).map((c) => ({ ...c, photo: photosFor(c.photo)[0] }));
---

<section class="cont section" aria-labelledby="cont-title">
  <div class="wrap">
    <h2 class="display h-lg cont-title" id="cont-title" data-split>Kontynent po kontynencie</h2>
    <ul class="cont-list" data-reveal>
      {items.map((c, i) => (
        <li class:list={['cont-item', { 'is-open': i === 1 }]}>
          <a href={`/kontynenty/${c.key}/`} class="cont-link">
            {c.photo && (
              <Image src={c.photo.src} alt={c.photo.alt} widths={[400, 800, 1200]} sizes="(max-width: 860px) 100vw, 50vw" quality={72} class="cont-img" />
            )}
            <span class="cont-shade" aria-hidden="true"></span>
            <span class="cont-name">{c.name}</span>
            <span class="cont-count">
              <strong>{c.visited}</strong>
              <span>/{c.total}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cont-title {
    margin-bottom: clamp(32px, 5vw, 64px);
  }

  .cont-list {
    display: flex;
    gap: 10px;
    height: clamp(420px, 62vh, 640px);
  }

  .cont-item {
    flex: 1 1 0;
    min-width: 0;
    transition: flex-grow 0.9s var(--ease-out);
  }

  .cont-item.is-open {
    flex-grow: 5;
  }

  .cont-link {
    position: relative;
    display: block;
    height: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-3);
  }

  .cont-link :global(.cont-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.08;
    transition: scale 1.2s var(--ease-out), filter 0.8s;
    filter: saturate(0.4) brightness(0.7);
  }

  .is-open .cont-link :global(.cont-img) {
    scale: 1;
    filter: none;
  }

  .cont-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(13 17 16 / 0.85) 0%, rgb(13 17 16 / 0) 55%);
  }

  .cont-name {
    position: absolute;
    left: 20px;
    bottom: 20px;
    font-weight: 800;
    font-stretch: 75%;
    font-size: clamp(2rem, 3.6vw, 3.6rem);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transform-origin: left bottom;
    transition: transform 0.9s var(--ease-out), font-size 0.6s;
  }

  .cont-item:not(.is-open) .cont-name {
    transform: translateX(calc(1em - 4px)) rotate(-90deg);
    font-size: clamp(1.4rem, 2vw, 2rem);
  }

  .cont-count {
    position: absolute;
    right: 20px;
    bottom: 20px;
    display: flex;
    align-items: baseline;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s, transform 0.8s var(--ease-out);
  }

  .is-open .cont-count {
    opacity: 1;
    transform: none;
    transition-delay: 0.25s;
  }

  .cont-count strong {
    font-size: clamp(2rem, 3.6vw, 3.6rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.9;
    color: var(--accent);
  }

  .cont-count span {
    font-size: 18px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .cont-list {
      flex-direction: column;
      height: auto;
    }

    .cont-item,
    .cont-item.is-open {
      flex: none;
      height: 132px;
    }

    .cont-link :global(.cont-img) {
      filter: none;
      scale: 1;
    }

    .cont-item:not(.is-open) .cont-name,
    .cont-name {
      transform: none;
      right: 96px;
      font-size: clamp(1.5rem, 7vw, 2rem);
      white-space: normal;
    }

    .cont-count,
    .is-open .cont-count {
      opacity: 1;
      transform: none;
    }

    .cont-count strong {
      font-size: 2rem;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('.cont-item');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const open = (el: HTMLElement) => items.forEach((i) => i.classList.toggle('is-open', i === el));
  items.forEach((el) => {
    el.addEventListener('mouseenter', () => fine.matches && open(el));
    el.addEventListener('focusin', () => open(el));
  });
</script>
