---
import CountryCard from '../CountryCard.astro';
import Icon from '../Icon.astro';
import type { Visit } from '../../lib/data';

interface Props {
  visits: Visit[];
}

const { visits } = Astro.props;
const [first, ...rest] = visits;
---

<section class="recent section" aria-labelledby="recent-title">
  <div class="wrap">
    <header class="recent-head">
      <h2 class="display h-lg" id="recent-title" data-split>Ostatnie pieczątki</h2>
      <a class="link-arrow" href="/kraje/">Wszystkie kraje <Icon name="arrowRight" /></a>
    </header>

    <div class="recent-grid">
      {first && <CountryCard visit={first} class="r-big" ratio="4 / 5" sizes="(max-width: 700px) 92vw, 46vw" />}
      {rest.slice(0, 4).map((v) => (
        <CountryCard visit={v} class="r-small" ratio="1 / 1" sizes="(max-width: 700px) 92vw, 22vw" />
      ))}
      {rest.slice(4, 6).map((v) => (
        <CountryCard visit={v} class="r-wide" ratio="16 / 10" sizes="(max-width: 700px) 92vw, 46vw" />
      ))}
    </div>
  </div>
</section>

<style>
  .recent-head {
    display: grid;
    justify-items: start;
    gap: 20px;
    margin-bottom: clamp(40px, 6vw, 80px);
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 56px) clamp(16px, 2vw, 28px);
    align-items: stretch;
  }

  .recent-grid :global(.r-big) {
    grid-column: 1 / span 6;
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
  }

  .recent-grid :global(.r-big .card-media) {
    flex: 1 1 auto;
    min-height: 320px;
    aspect-ratio: auto;
  }

  .recent-grid :global(.r-small) {
    grid-column: span 3;
  }

  .recent-grid :global(.r-wide) {
    grid-column: span 6;
  }

  @media (max-width: 900px) {
    .recent-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .recent-grid :global(.r-big),
    .recent-grid :global(.r-wide) {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .recent-grid :global(.r-big .card-media) {
      flex: none;
      aspect-ratio: 4 / 3;
      min-height: 0;
    }

    .recent-grid :global(.r-small) {
      grid-column: span 1;
    }
  }

  @media (max-width: 520px) {
    .recent-grid :global(.r-small) {
      grid-column: 1 / -1;
    }
  }
</style>
