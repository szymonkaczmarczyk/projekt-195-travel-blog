---
import Icon from '../Icon.astro';
import { site } from '../../data/meta';
import { continentStats, type Visit } from '../../lib/data';

interface Props {
  visits: Visit[];
}

const { visits } = Astro.props;
const perContinent = continentStats(visits);
const share = (visits.length / site.total) * 100;
---

<section class="globe-sec" id="mapa" aria-labelledby="globe-title">
  <p class="globe-word display" aria-hidden="true">Świat</p>
  <div class="wrap globe-grid">
    <div class="globe-head">
      <h2 class="display h-lg" id="globe-title" data-split>Mapa pieczątek</h2>
      <p class="globe-lead" data-reveal>Pomarańczowe kraje są już odhaczone. Złap globus i zakręć nim, a kliknięcie w kraj otworzy relację.</p>
      <a class="link-arrow globe-more" href="/globus/" data-reveal>Pełny globus z pinezkami <Icon name="arrowRight" /></a>
    </div>

    <div class="globe" data-globe>
      <canvas role="img" aria-label={`Globus: ${visits.length} odwiedzonych krajów zaznaczonych na pomarańczowo`}></canvas>
      <div class="globe-tip" data-globe-tip hidden>
        <strong data-tip-name></strong>
        <span data-tip-status></span>
      </div>
      <p class="globe-hint hand" aria-hidden="true">przeciągnij, żeby obrócić</p>
    </div>

    <aside class="pass" aria-label="Postęp projektu" data-reveal>
      <div class="pass-top">
        <span>Karta pokładowa</span>
        <span>{site.name}</span>
      </div>
      <div class="pass-route">
        <div>
          <small>z</small>
          <strong>WAW</strong>
          <span>Warszawa</span>
        </div>
        <span class="pass-plane"><Icon name="airplane" size={26} /></span>
        <div class="pass-to">
          <small>do</small>
          <strong>ALL</strong>
          <span>wszędzie</span>
        </div>
      </div>
      <p class="pass-count"><span data-count={visits.length}>{visits.length}</span><small>/{site.total} krajów</small></p>
      <div class="pass-bars" aria-hidden="true" style={`--share:${share}%`}>
        <span class="pass-bars-done"></span>
        <span class="pass-bars-left"></span>
      </div>
      <dl class="pass-table">
        {perContinent.map((c) => (
          <div>
            <dt><a href={`/kontynenty/${c.key}/`}>{c.name}</a></dt>
            <dd>{c.visited}<span>/{c.total}</span></dd>
          </div>
        ))}
      </dl>
      <div class="pass-next">
        <span>Następny przystanek</span>
        <strong>{site.next.name}</strong>
        <span class="hand">{site.next.when}</span>
      </div>
    </aside>
  </div>
</section>

<style>
  .globe-sec {
    position: relative;
    padding-block: clamp(80px, 10vw, 160px);
    overflow: hidden;
    background: radial-gradient(ellipse 70% 60% at 65% 55%, #16201c 0%, var(--bg) 70%);
  }

  .globe-word {
    position: absolute;
    left: 50%;
    top: 54%;
    transform: translate(-50%, -50%);
    font-size: clamp(9rem, 34vw, 36rem);
    line-height: 0.8;
    color: rgb(236 233 225 / 0.06);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .globe-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: center;
  }

  .globe-head {
    grid-column: 1 / span 5;
    grid-row: 1;
    align-self: start;
    display: grid;
    gap: 20px;
    position: relative;
    z-index: 2;
  }

  .globe-lead {
    max-width: 36ch;
    color: var(--muted);
  }

  .globe-more {
    justify-self: start;
  }

  .globe {
    grid-column: 5 / -1;
    grid-row: 1 / span 2;
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 820px;
    justify-self: end;
    opacity: 0;
    transform: scale(0.94);
    transition: opacity 1.2s var(--ease-out), transform 1.6s var(--ease-out);
  }

  .globe:global(.is-ready) {
    opacity: 1;
    transform: none;
  }

  .globe canvas {
    width: 100%;
    height: 100%;
    touch-action: pan-y;
    cursor: grab;
  }

  .globe-tip {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--paper);
    color: var(--paper-ink);
    pointer-events: none;
    white-space: nowrap;
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.35);
  }

  .globe-tip[hidden] {
    display: none;
  }

  .globe-tip strong {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
  }

  .globe-tip span {
    font-size: 13px;
    color: #4d5752;
  }

  .globe-tip[data-visited='true'] span {
    color: var(--accent-ink);
  }

  .globe-hint {
    position: absolute;
    right: 6%;
    bottom: 4%;
    font-size: 20px;
    color: var(--muted);
    transform: rotate(-6deg);
  }

  .pass {
    grid-column: 1 / span 4;
    grid-row: 2;
    align-self: end;
    position: relative;
    z-index: 2;
    max-width: 380px;
    padding: 22px 22px 20px;
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--paper-ink);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.45);
    transform: rotate(-2deg);
  }

  .pass::before,
  .pass::after {
    content: '';
    position: absolute;
    top: 118px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--bg);
  }

  .pass::before {
    left: -11px;
  }

  .pass::after {
    right: -11px;
  }

  .pass-top {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 600;
    color: #5b655f;
  }

  .pass-route {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding-bottom: 20px;
    border-bottom: 2px dashed rgb(21 26 24 / 0.18);
  }

  .pass-route div {
    display: grid;
  }

  .pass-route small {
    font-size: 11px;
    color: #5b655f;
  }

  .pass-route strong {
    font-size: 40px;
    font-weight: 800;
    font-stretch: 75%;
    line-height: 1;
  }

  .pass-route span {
    font-size: 13px;
  }

  .pass-to {
    text-align: right;
  }

  .pass-plane {
    display: grid;
    color: var(--accent-ink);
  }

  .pass-count {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 18px;
    font-size: 84px;
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--accent-ink);
  }

  .pass-count small {
    font-size: 18px;
    font-weight: 600;
    font-stretch: 90%;
    letter-spacing: 0;
    color: var(--paper-ink);
  }

  .pass-bars {
    display: flex;
    height: 38px;
    margin-top: 14px;
  }

  .pass-bars span {
    height: 100%;
    background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 4px);
  }

  .pass-bars-done {
    width: var(--share);
    color: var(--paper-ink);
  }

  .pass-bars-left {
    flex: 1;
    color: rgb(21 26 24 / 0.18);
  }

  .pass-table {
    display: grid;
    gap: 6px;
    margin: 18px 0 0;
    padding-top: 16px;
    border-top: 2px dashed rgb(21 26 24 / 0.18);
    font-size: 14px;
  }

  .pass-table div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .pass-table dt a:hover {
    text-decoration: underline;
  }

  .pass-table dd {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .pass-table dd span {
    font-weight: 400;
    color: #5b655f;
  }

  .pass-next {
    display: grid;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 2px dashed rgb(21 26 24 / 0.18);
    font-size: 12px;
    color: #5b655f;
  }

  .pass-next strong {
    font-size: 26px;
    font-weight: 800;
    font-stretch: 80%;
    line-height: 1.1;
    color: var(--paper-ink);
  }

  .pass-next .hand {
    font-size: 18px;
    color: var(--accent-ink);
  }

  @media (max-width: 960px) {
    .globe-grid {
      grid-template-columns: 1fr;
    }

    .globe-head,
    .globe,
    .pass {
      grid-column: 1;
      grid-row: auto;
    }

    .globe {
      justify-self: center;
      max-width: 620px;
    }

    .pass {
      justify-self: center;
      width: 100%;
      transform: rotate(-1.5deg);
    }

    .globe-word {
      top: 46%;
    }
  }
</style>

<script>
  import { reduced } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-globe]');
  if (root) {
    const io = new IntersectionObserver(
      async ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        const { mountGlobe } = await import('../../scripts/globe');
        mountGlobe(root, { reduced });
      },
      { rootMargin: '600px' },
    );
    io.observe(root);
  }
</script>
