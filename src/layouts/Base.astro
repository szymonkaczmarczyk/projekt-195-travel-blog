---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource/sedgwick-ave/400.css';
import '../styles/global.css';
import brico from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wdth-normal.woff2?url';
import bricoExt from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-ext-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/meta';
import type { OgImage } from '../lib/og';

interface Props {
  title?: string;
  description?: string;
  image?: OgImage;
  type?: 'website' | 'article';
  headerTone?: 'overlay' | 'solid';
  noindex?: boolean;
}

const { title, description = site.description, image, type = 'website', headerTone = 'solid', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.claim}`;
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const og = image ?? { src: '/og/default.jpg', alt: 'Napis „Złapać świat” schowany za grzbietem grupy Sella w Dolomitach' };
const ogUrl = new URL(og.src, origin).href;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0d1110" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${site.name}: ${site.claim}`} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={og.alt} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preload" href={brico} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bricoExt} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <Header tone={headerTone} />
    <main id="tresc">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--paper);
    color: var(--paper-ink);
    transform: translateY(-200%);
    transition: transform 0.3s var(--ease-out);
  }

  .skip:focus {
    transform: none;
  }
</style>
